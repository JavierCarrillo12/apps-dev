<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
 <TextView android:id="@+id/titulo_formulario" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/agregar_empresa" android:textAppearance="?android:attr/textAppearanceLarge" />
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/campos_obligatorios" android:paddingVertical="8dp" />
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@+id/nombre" android:text="@string/nombre" />
 <EditText android:importantForAutofill="no" android:id="@id/nombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textCapWords" android:maxLines="1" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@+id/url" android:text="@string/url" />
 <EditText android:importantForAutofill="no" android:id="@id/url" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textUri" android:maxLines="1" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@+id/telefono" android:text="@string/telefono" />
 <EditText android:importantForAutofill="no" android:id="@id/telefono" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="phone" android:maxLines="1" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@+id/email" android:text="@string/email" />
 <EditText android:importantForAutofill="no" android:id="@id/email" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textEmailAddress" android:maxLines="1" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@+id/productos" android:text="@string/productos" />
 <EditText android:importantForAutofill="no" android:id="@id/productos" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textCapSentences|textMultiLine" android:minLines="2" android:gravity="top" />
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/clasificacion" />
 <CheckBox android:id="@+id/consultoria" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/consultoria" />
 <CheckBox android:id="@+id/desarrollo" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/desarrollo" />
 <CheckBox android:id="@+id/fabrica" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/fabrica" />
 <TextView android:id="@+id/error_formulario" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:visibility="gone" android:paddingVertical="8dp" />
 <Button android:id="@+id/guardar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/guardar" />
 <Button style="@style/Widget.Reto8SQLite.SecondaryButton" android:id="@+id/cancelar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cancelar" />
 </LinearLayout>
</ScrollView>

